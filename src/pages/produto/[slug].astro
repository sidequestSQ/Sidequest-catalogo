---
import Layout from '../../layouts/Layout.astro';
import ChannelButton from '../../components/ChannelButton.astro';

import { products } from '../../data/products';
import { categories } from '../../data/categories';
import { channels } from '../../data/channels';

import { formatPrice } from '../../utils/price';
import {
  getProductChannelPrice,
  getProductPrice,
} from '../../utils/promotions';
import {
  isValidOfficialChannel,
} from '../../utils/channels';
import {
  getPrimaryProductImage,
  getProductGallery,
} from '../../utils/images';

export function getStaticPaths() {
  return products
    .filter(
      (product) =>
        product.status !== 'oculto'
    )
    .map((product) => ({
      params: {
        slug: product.slug,
      },
      props: {
        product,
      },
    }));
}

const { product } = Astro.props;

const category =
  categories.find(
    (item) =>
      item.id === product.categoryId
  );

const primaryImage =
  getPrimaryProductImage(product);

const gallery =
  getProductGallery(product);

const productPrice =
  getProductPrice(product);

const productChannels =
  product.channels
    .filter(
      (productChannel) =>
        productChannel.active
    )
    .map((productChannel) => {
      const channel =
        channels.find(
          (item) =>
            item.id ===
              productChannel.channelId &&
            item.active &&
            item.showOnProducts &&
            isValidOfficialChannel(item)
        );

      if (!channel) {
        return null;
      }

      const price =
        getProductChannelPrice(
          product,
          productChannel
        );

      return {
        productChannel,
        channel,
        price,
      };
    })
    .filter(
      (
        item
      ): item is NonNullable<typeof item> =>
        item !== null
    );
---

<Layout
  title={`${product.name} — Side Quest`}
  description={product.shortDescription}
>
  <main class="product-page">
    <div class="container">
      <a
        href="/catalogo/"
        class="back-link"
      >
        ← Voltar para o catálogo
      </a>

      <section class="product-layout">
        <div class="product-gallery">
          {primaryImage ? (
            <>
              <div class="main-image-wrapper">
                <img
                  id="product-main-image"
                  src={primaryImage.src}
                  alt={primaryImage.alt}
                />
              </div>

              {gallery.length > 1 && (
                <div
                  class="thumbnail-list"
                  aria-label="Imagens do produto"
                >
                  {gallery.map(
                    (image, index) => (
                      <button
                        type="button"
                        class:list={{
                          thumbnail: true,
                          'thumbnail-active':
                            image.src ===
                            primaryImage.src &&
                            image.alt ===
                            primaryImage.alt,
                        }}
                        data-image-src={
                          image.src
                        }
                        data-image-alt={
                          image.alt
                        }
                        aria-label={`Ver imagem ${index + 1} de ${gallery.length}`}
                        aria-pressed={
                          image.src ===
                            primaryImage.src &&
                          image.alt ===
                            primaryImage.alt
                        }
                      >
                        <img
                          src={image.src}
                          alt=""
                          loading={
                            index === 0
                              ? 'eager'
                              : 'lazy'
                          }
                        />
                      </button>
                    )
                  )}
                </div>
              )}
            </>
          ) : (
            <div class="image-placeholder">
              Sem imagem
            </div>
          )}

          {gallery.length > 1 && (
            <div
              class="gallery-counter"
              aria-hidden="true"
            >
              {gallery.length} imagens
            </div>
          )}
        </div>

        <div class="product-info">
          {category && (
            <a
              href={`/catalogo/?categoria=${category.slug}`}
              class="product-category"
            >
              {category.name}
            </a>
          )}

          <h1>{product.name}</h1>

          <p class="product-description">
            {product.description}
          </p>

          <div class="general-price">
            <span class="price-label">
              {productPrice.discountCents > 0
                ? 'Preço promocional'
                : 'Preço do catálogo'}
            </span>

            <div class="price-values">
              {productPrice.discountCents > 0 && (
                <span class="old-price">
                  {formatPrice(
                    productPrice.originalPriceCents
                  )}
                </span>
              )}

              <strong>
                {formatPrice(
                  productPrice.finalPriceCents
                )}
              </strong>

              {productPrice.discountCents > 0 && (
                <span class="discount-badge">
                  -{productPrice.discountPercent}%
                </span>
              )}
            </div>
          </div>

          {productChannels.length > 0 && (
            <section class="channel-prices">
              <h2>
                Onde encontrar
              </h2>

              <div class="channel-list">
                {productChannels.map(
                  ({
                    productChannel,
                    channel,
                    price,
                  }) => (
                    <div
                      class="channel-offer"
                    >
                      <div class="channel-offer-info">
                        <strong>
                          {channel.name}
                        </strong>

                        <div class="channel-price">
                          {price.discountCents >
                          0 ? (
                            <>
                              <span class="old-price">
                                {formatPrice(
                                  price.originalPriceCents
                                )}
                              </span>

                              <strong class="sale-price">
                                {formatPrice(
                                  price.finalPriceCents
                                )}
                              </strong>

                              <span class="discount">
                                -{price.discountPercent}%
                              </span>
                            </>
                          ) : (
                            <strong>
                              {formatPrice(
                                price.finalPriceCents
                              )}
                            </strong>
                          )}
                        </div>
                      </div>

                      <ChannelButton
                        channel={channel}
                        productName={product.name}
                        message={
                          productChannel.message
                        }
                      />
                    </div>
                  )
                )}
              </div>
            </section>
          )}

          <div class="product-meta">
            <div>
              <span>Status</span>
              <strong>
                {product.status}
              </strong>
            </div>

            <div>
              <span>SKU</span>
              <strong>
                {product.sku}
              </strong>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  const mainImage =
    document.querySelector<HTMLImageElement>(
      '#product-main-image'
    );

  const thumbnails =
    document.querySelectorAll<HTMLButtonElement>(
      '.thumbnail'
    );

  if (mainImage && thumbnails.length > 0) {
    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener(
        'click',
        () => {
          const imageSrc =
            thumbnail.dataset.imageSrc;

          const imageAlt =
            thumbnail.dataset.imageAlt;

          if (!imageSrc || !imageAlt) {
            return;
          }

          mainImage.src = imageSrc;
          mainImage.alt = imageAlt;

          thumbnails.forEach(
            (item) => {
              const isActive =
                item === thumbnail;

              item.classList.toggle(
                'thumbnail-active',
                isActive
              );

              item.setAttribute(
                'aria-pressed',
                String(isActive)
              );
            }
          );
        }
      );
    });
  }
</script>

<style>
  .product-page {
    padding: 42px 0 80px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .product-layout {
    display: grid;
    gap: 36px;
  }

  .product-gallery {
    position: relative;
    min-width: 0;
  }

  .main-image-wrapper {
    display: grid;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .main-image-wrapper img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .image-placeholder {
    display: grid;
    min-height: 320px;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .thumbnail-list {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
    padding: 2px 2px 6px;
    scrollbar-width: thin;
  }

  .thumbnail {
    position: relative;
    flex: 0 0 76px;
    width: 76px;
    height: 76px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
    opacity: 0.68;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .thumbnail:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .thumbnail-active {
    border-color: var(--color-primary-light);
    opacity: 1;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-counter {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(
      21,
      24,
      39,
      0.88
    );
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .product-info {
    max-width: 680px;
  }

  .product-category {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--color-primary-light);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: 1.05;
  }

  .product-description {
    margin: 20px 0 28px;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .general-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 30px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
  }

  .price-label {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .price-values {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
  }

  .price-values strong {
    font-size: 1.35rem;
  }

  .old-price {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-decoration: line-through;
  }

  .discount-badge {
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .channel-prices {
    margin-top: 30px;
  }

  .channel-prices h2 {
    margin: 0 0 14px;
    font-size: 1.1rem;
  }

  .channel-list {
    display: grid;
    gap: 14px;
  }

  .channel-offer {
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .channel-offer-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .channel-offer-info > strong {
    font-size: 0.95rem;
  }

  .channel-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .channel-price strong {
    font-size: 1.1rem;
  }

  .sale-price {
    color: var(--color-primary-light);
  }

  .discount {
    padding: 3px 7px;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .product-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 30px;
  }

  .product-meta div {
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .product-meta span {
    display: block;
    margin-bottom: 4px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .product-meta strong {
    font-size: 0.85rem;
    text-transform: capitalize;
  }

  @media (min-width: 800px) {
    .product-layout {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 0.9fr);
      align-items: start;
    }

    .product-gallery {
      position: sticky;
      top: 110px;
    }
  }

  @media (max-width: 520px) {
    .general-price {
      align-items: flex-start;
      flex-direction: column;
    }

    .price-values {
      justify-content: flex-start;
    }

    .channel-offer-info {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .channel-price {
      justify-content: flex-start;
    }

    .product-meta {
      grid-template-columns: 1fr;
    }

    .thumbnail {
      flex-basis: 68px;
      width: 68px;
      height: 68px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumbnail {
      transition: none;
    }
  }
</style>
