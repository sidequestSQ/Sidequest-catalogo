---
import Layout from '../../layouts/Layout.astro';
import ChannelButton from '../../components/ChannelButton.astro';

import { products } from '../../data/products';
import { categories } from '../../data/categories';
import { channels } from '../../data/channels';

import { formatPrice } from '../../utils/price';
import {
  getProductChannelPrice,
  getProductPrice,
} from '../../utils/promotions';

import {
  isValidOfficialChannel,
} from '../../utils/channels';

import {
  getPrimaryProductImage,
  getProductGallery,
} from '../../utils/images';

export function getStaticPaths() {
  return products
    .filter((product) => product.status !== 'oculto')
    .map((product) => ({
      params: {
        slug: product.slug,
      },
      props: {
        product,
      },
    }));
}

const { product } = Astro.props;

const category = categories.find(
  (item) => item.id === product.categoryId
);

const primaryImage = getPrimaryProductImage(product);
const gallery = getProductGallery(product);
const productPrice = getProductPrice(product);

const productChannels = product.channels
  .filter((productChannel) => productChannel.active)
  .map((productChannel) => {
    const channel = channels.find(
      (item) =>
        item.id === productChannel.channelId &&
        item.active &&
        item.showOnProducts &&
        isValidOfficialChannel(item)
    );

    if (!channel) {
      return null;
    }

    const price = getProductChannelPrice(
      product,
      productChannel
    );

    return {
      productChannel,
      channel,
      price,
    };
  })
  .filter(
    (item): item is NonNullable<typeof item> =>
      item !== null
  );

const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') ??
  'https://sidequest.store';

const productUrl = new URL(
  `/produto/${product.slug}/`,
  siteUrl
).toString();

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  sku: product.sku,
  url: productUrl,

  image: gallery.map(
    (image) =>
      new URL(image.src, siteUrl).toString()
  ),

  brand: {
    '@type': 'Brand',
    name: 'Side Quest',
  },

  offers: {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: 'BRL',
    price: (
      productPrice.finalPriceCents / 100
    ).toFixed(2),
    availability:
      product.status === 'disponivel'
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
  },
};
---

<Layout
  title={`${product.name} — Side Quest`}
  description={product.shortDescription}
  canonical={`/produto/${product.slug}/`}
  ogImage={primaryImage?.src ?? '/og-image.svg'}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
  />

  <main class="product-page">
    <div
      class="product-background"
      aria-hidden="true"
    >
      <span class="background-glow background-glow-one"></span>
      <span class="background-glow background-glow-two"></span>
      <span class="background-grid"></span>
    </div>

    <div class="container">
      <a
        href="/catalogo/"
        class="back-link"
      >
        <span class="back-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M19 12H5M11 18l-6-6 6-6"
            />
          </svg>
        </span>

        Voltar para o catálogo
      </a>

      <section class="product-layout">
        <div class="product-gallery">
          {primaryImage ? (
            <>
              <div class="gallery-frame">
                <div
                  class="main-image-wrapper"
                  id="product-image-viewer"
                >
                  <div
                    class="image-background"
                    aria-hidden="true"
                  ></div>

                  <div
                    class="image-grid"
                    aria-hidden="true"
                  ></div>

                  <div
                    class="image-glow"
                    aria-hidden="true"
                  ></div>

                  <img
                    id="product-main-image"
                    src={primaryImage.src}
                    alt={primaryImage.alt}
                    loading="eager"
                    decoding="async"
                  />

                  <span
                    class="image-corner image-corner-top"
                    aria-hidden="true"
                  ></span>

                  <span
                    class="image-corner image-corner-bottom"
                    aria-hidden="true"
                  ></span>

                  <span
                    class="image-label"
                    aria-hidden="true"
                  >
                    SIDE QUEST
                  </span>

                  {gallery.length > 1 && (
                    <div
                      class="gallery-counter"
                      aria-hidden="true"
                    >
                      <span class="counter-dot"></span>
                      <span>
                        1 / {gallery.length}
                      </span>
                    </div>
                  )}
                </div>
              </div>

              {gallery.length > 1 && (
                <div class="thumbnail-area">
                  <div class="thumbnail-header">
                    <span>IMAGENS DO PRODUTO</span>

                    <span class="thumbnail-count">
                      {gallery.length} fotos
                    </span>
                  </div>

                  <div
                    class="thumbnail-list"
                    aria-label="Imagens do produto"
                  >
                    {gallery.map(
                      (image, index) => (
                        <button
                          type="button"
                          class:list={{
                            thumbnail: true,
                            'thumbnail-active':
                              image.src ===
                                primaryImage.src &&
                              image.alt ===
                                primaryImage.alt,
                          }}
                          data-image-src={
                            image.src
                          }
                          data-image-alt={
                            image.alt
                          }
                          data-image-index={
                            index + 1
                          }
                          aria-label={`Ver imagem ${index + 1} de ${gallery.length}`}
                          aria-pressed={
                            image.src ===
                              primaryImage.src &&
                            image.alt ===
                              primaryImage.alt
                          }
                        >
                          <img
                            src={image.src}
                            alt=""
                            loading={
                              index === 0
                                ? 'eager'
                                : 'lazy'
                            }
                          />

                          <span
                            class="thumbnail-number"
                            aria-hidden="true"
                          >
                            {index + 1}
                          </span>

                          <span
                            class="thumbnail-active-mark"
                            aria-hidden="true"
                          ></span>
                        </button>
                      )
                    )}
                  </div>
                </div>
              )}
            </>
          ) : (
            <div class="image-placeholder">
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="2"
                />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <path
                  d="m21 15-5-5L5 21"
                />
              </svg>

              <span>Sem imagem disponível</span>
            </div>
          )}
        </div>

        <div class="product-info">
          <div class="product-heading">
            {category && (
              <a
                href={`/catalogo/?categoria=${category.slug}`}
                class="product-category"
              >
                <span
                  class="category-mark"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 3v18M3 12h18"
                    />
                  </svg>
                </span>

                {category.name}
              </a>
            )}

            <div class="title-line" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <h1>{product.name}</h1>

            <p class="product-description">
              {product.description}
            </p>

            <div class="product-identifiers">
              <span>
                <span class="identifier-dot"></span>
                Produto oficial
              </span>

              <span>
                SKU {product.sku}
              </span>
            </div>
          </div>

          <div class="general-price">
            <div class="price-copy">
              <span class="price-label">
                {productPrice.discountCents > 0
                  ? 'Preço promocional'
                  : 'Preço do catálogo'}
              </span>

              {productPrice.discountCents > 0 && (
                <span class="saving-label">
                  Você economiza{' '}
                  {formatPrice(
                    productPrice.discountCents
                  )}
                </span>
              )}
            </div>

            <div class="price-values">
              {productPrice.discountCents > 0 && (
                <span class="old-price">
                  {formatPrice(
                    productPrice.originalPriceCents
                  )}
                </span>
              )}

              <strong>
                {formatPrice(
                  productPrice.finalPriceCents
                )}
              </strong>

              {productPrice.discountCents > 0 && (
                <span class="discount-badge">
                  -{productPrice.discountPercent}%
                </span>
              )}
            </div>
          </div>

          {productChannels.length > 0 && (
            <section class="channel-prices">
              <div class="section-heading">
                <div>
                  <span class="section-eyebrow">
                    CANAIS OFICIAIS
                  </span>

                  <h2>Onde encontrar</h2>
                </div>

                <span
                  class="section-line"
                  aria-hidden="true"
                ></span>
              </div>

              <p class="section-description">
                Escolha um canal oficial da Side Quest
                para conhecer ou comprar este produto.
              </p>

              <div class="channel-list">
                {productChannels.map(
                  ({
                    productChannel,
                    channel,
                    price,
                  }) => (
                    <div
                      class="channel-offer"
                    >
                      <div class="channel-offer-info">
                        <div class="channel-name-area">
                          <span
                            class:list={{
                              'channel-icon': true,
                              'channel-icon-whatsapp':
                                channel.type ===
                                'whatsapp',
                              'channel-icon-instagram':
                                channel.type ===
                                'instagram',
                            }}
                            aria-hidden="true"
                          >
                            {channel.type ===
                            'whatsapp' ? (
                              <svg viewBox="0 0 24 24">
                                <path
                                  d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"
                                />
                                <path
                                  d="M8.8 8.3c.2-.3.4-.3.7-.3h.5c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4-.1.6l-.6.7c.6 1.1 1.5 2 2.6 2.6l.7-.6c.2-.2.4-.2.6-.1l1.7.7c.3.1.4.3.4.5v.5c0 .3-.1.5-.3.7-.4.4-1 .6-1.5.5-1.4-.2-3.1-1.1-4.5-2.5-1.4-1.4-2.3-3.1-2.5-4.5-.1-.6.1-1.1.5-1.5Z"
                                />
                              </svg>
                            ) : channel.type ===
                              'instagram' ? (
                              <svg viewBox="0 0 24 24">
                                <rect
                                  x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="5"
                                />
                                <circle
                                  cx="12"
                                  cy="12"
                                  r="4"
                                />
                                <circle
                                  cx="17.5"
                                  cy="6.5"
                                  r="1"
                                />
                              </svg>
                            ) : (
                              <svg viewBox="0 0 24 24">
                                <path
                                  d="M12 3 14.7 9.3 21 12l-6.3 2.7L12 21l-2.7-6.3L3 12l6.3-2.7L12 3Z"
                                />
                              </svg>
                            )}
                          </span>

                          <div>
                            <strong>
                              {channel.name}
                            </strong>

                            <span>
                              Canal oficial da loja
                            </span>
                          </div>
                        </div>

                        <div class="channel-price">
                          {price.discountCents >
                          0 ? (
                            <>
                              <span class="old-price">
                                {formatPrice(
                                  price.originalPriceCents
                                )}
                              </span>

                              <strong class="sale-price">
                                {formatPrice(
                                  price.finalPriceCents
                                )}
                              </strong>

                              <span class="discount">
                                -{price.discountPercent}%
                              </span>
                            </>
                          ) : (
                            <strong>
                              {formatPrice(
                                price.finalPriceCents
                              )}
                            </strong>
                          )}
                        </div>
                      </div>

                      <ChannelButton
                        channel={channel}
                        productName={product.name}
                        message={productChannel.message}
                        price={formatPrice(
                          price.finalPriceCents
                        )}
                        categoryName={category?.name}
                        sku={product.sku}
                      />
                    </div>
                  )
                )}
              </div>
            </section>
          )}

          <div class="product-meta">
            <div>
              <span>Status</span>

              <strong
                class:list={{
                  'meta-status':
                    product.status ===
                    'disponivel',
                }}
              >
                <span
                  class="meta-dot"
                  aria-hidden="true"
                ></span>

                {product.status}
              </strong>
            </div>

            <div>
              <span>SKU</span>

              <strong>
                {product.sku}
              </strong>
            </div>
          </div>

          <div class="product-note">
            <span
              class="note-icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24">
                <path
                  d="M12 3v18M3 12h18"
                />
              </svg>
            </span>

            <p>
              A disponibilidade e os valores podem
              variar conforme o canal oficial.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  const mainImage =
    document.querySelector<HTMLImageElement>(
      '#product-main-image'
    );

  const thumbnails =
    document.querySelectorAll<HTMLButtonElement>(
      '.thumbnail'
    );

  const galleryCounter =
    document.querySelector(
      '.gallery-counter span:last-child'
    );

  if (mainImage && thumbnails.length > 0) {
    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener(
        'click',
        () => {
          const imageSrc =
            thumbnail.dataset.imageSrc;

          const imageAlt =
            thumbnail.dataset.imageAlt;

          const imageIndex =
            thumbnail.dataset.imageIndex;

          if (!imageSrc || !imageAlt) {
            return;
          }

          mainImage.classList.add(
            'image-changing'
          );

          window.setTimeout(() => {
            mainImage.src = imageSrc;
            mainImage.alt = imageAlt;

            mainImage.classList.remove(
              'image-changing'
            );
          }, 120);

          thumbnails.forEach(
            (item) => {
              const isActive =
                item === thumbnail;

              item.classList.toggle(
                'thumbnail-active',
                isActive
              );

              item.setAttribute(
                'aria-pressed',
                String(isActive)
              );
            }
          );

          if (galleryCounter && imageIndex) {
            galleryCounter.textContent =
              `${imageIndex} / ${thumbnails.length}`;
          }
        }
      );
    });
  }
</script>

<style>
  .product-page {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    padding: 42px 0 90px;
  }

  .product-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .background-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
  }

  .background-glow-one {
    top: 4%;
    right: -180px;
    width: 420px;
    height: 420px;
    background: rgba(118, 103, 168, 0.08);
  }

  .background-glow-two {
    bottom: 8%;
    left: -220px;
    width: 400px;
    height: 400px;
    background: rgba(95, 200, 216, 0.035);
  }

  .background-grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(
        rgba(145, 134, 189, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(145, 134, 189, 0.035) 1px,
        transparent 1px
      );
    background-size: 46px 46px;
    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 72%
    );
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 30px;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 700;
    transition:
      color var(--transition-base),
      transform var(--transition-base);
  }

  .back-icon {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: rgba(28, 32, 50, 0.72);
    color: var(--color-cyan);
    transition:
      border-color var(--transition-base),
      background var(--transition-base),
      transform var(--transition-base);
  }

  .back-icon svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .back-link:hover .back-icon {
    border-color: rgba(95, 200, 216, 0.3);
    background: rgba(95, 200, 216, 0.08);
    transform: translateX(-2px);
  }

  .product-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.02fr)
      minmax(360px, 0.98fr);
    align-items: start;
    gap: clamp(34px, 5vw, 72px);
  }

  .product-gallery,
  .product-info {
    min-width: 0;
  }

  .product-info {
    max-width: 680px;
  }

  .gallery-frame {
    position: relative;
  }

  .main-image-wrapper {
    position: relative;
    display: grid;
    min-height: 520px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(220, 224, 240, 0.14);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(118, 103, 168, 0.16),
        transparent 48%
      ),
      radial-gradient(
        circle at 15% 90%,
        rgba(95, 200, 216, 0.055),
        transparent 34%
      ),
      radial-gradient(
        circle at 88% 12%,
        rgba(176, 106, 200, 0.055),
        transparent 32%
      ),
      var(--color-surface);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
    isolation: isolate;
  }

  .main-image-wrapper::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        135deg,
        rgba(95, 200, 216, 0.04),
        transparent 30%,
        transparent 70%,
        rgba(176, 106, 200, 0.045)
      );
    content: "";
    pointer-events: none;
    z-index: 1;
  }

  .main-image-wrapper::after {
    position: absolute;
    right: 18%;
    bottom: -35%;
    left: 18%;
    height: 45%;
    border-radius: 50%;
    background: rgba(118, 103, 168, 0.12);
    filter: blur(40px);
    content: "";
    pointer-events: none;
    z-index: 0;
  }

  .image-background {
    position: absolute;
    width: 65%;
    aspect-ratio: 1;
    border: 1px solid rgba(145, 134, 189, 0.07);
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(118, 103, 168, 0.08),
        transparent 65%
      );
    z-index: 0;
  }

  .image-grid {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(
        rgba(220, 224, 240, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(220, 224, 240, 0.025) 1px,
        transparent 1px
      );
    background-size: 32px 32px;
    mask-image: radial-gradient(
      circle at center,
      black,
      transparent 70%
    );
    z-index: 0;
  }

  .image-glow {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(95, 200, 216, 0.055);
    filter: blur(50px);
    z-index: 0;
  }

  .main-image-wrapper img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  filter: saturate(0.96) contrast(1.02);
  transition:
    transform var(--transition-slow),
    filter var(--transition-base);
}

  .main-image-wrapper img:hover {
    transform: scale(1.012);
  }

  .main-image-wrapper img.image-changing {
    opacity: 0.25;
  }

  .image-corner {
    position: absolute;
    width: 28px;
    height: 28px;
    z-index: 3;
    pointer-events: none;
  }

  .image-corner-top {
    top: 16px;
    left: 16px;
    border-top: 1px solid rgba(95, 200, 216, 0.4);
    border-left: 1px solid rgba(95, 200, 216, 0.4);
  }

  .image-corner-bottom {
    right: 16px;
    bottom: 16px;
    border-right: 1px solid rgba(176, 106, 200, 0.34);
    border-bottom: 1px solid rgba(176, 106, 200, 0.34);
  }


  image-label {
    position: absolute;
    bottom: 17px;
    left: 20px;
    z-index: 4;
    color: rgba(228, 229, 236, 0.42);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.18em;
  }

  .gallery-counter {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border: 1px solid rgba(95, 200, 216, 0.2);
    border-radius: 999px;
    background:
      linear-gradient(
        135deg,
        rgba(21, 24, 39, 0.9),
        rgba(37, 42, 61, 0.82)
      );
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text-strong);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .counter-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow:
      0 0 8px rgba(95, 200, 216, 0.5);
  }

  .image-placeholder {
    display: grid;
    min-height: 520px;
    place-items: center;
    gap: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .image-placeholder svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }

  .thumbnail-area {
    margin-top: 15px;
  }

  .thumbnail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 9px;
    padding: 0 2px;
  }

