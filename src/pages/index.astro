---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import OfficialChannels from '../components/OfficialChannels.astro';
import { products } from '../data/products';
import { categories } from '../data/categories';

const featuredProducts = products.filter(
  (product) => product.featured && product.status !== 'oculto'
);

const activeCategories = categories.filter(
  (category) => category.active
);
---

<Layout
  title="Side Quest — Catálogo Geek"
  description="Descubra pelúcias, chaveiros, colecionáveis e produtos geek no catálogo oficial da Side Quest."
>
  <main>
    <section class="hero">
      <div class="hero-background" aria-hidden="true">
        <span class="hero-grid"></span>

        <span class="hero-glow hero-glow-purple"></span>
        <span class="hero-glow hero-glow-cyan"></span>
        <span class="hero-glow hero-glow-magenta"></span>
        <span class="hero-glow hero-glow-gold"></span>

        <span class="hero-particle particle-one"></span>
        <span class="hero-particle particle-two"></span>
        <span class="hero-particle particle-three"></span>
        <span class="hero-particle particle-four"></span>
        <span class="hero-particle particle-five"></span>
        <span class="hero-particle particle-six"></span>
        <span class="hero-particle particle-seven"></span>
        <span class="hero-particle particle-eight"></span>

        <span class="hero-rune rune-one">✦</span>
        <span class="hero-rune rune-two">◇</span>
        <span class="hero-rune rune-three">+</span>
      </div>

      <div class="container hero-inner">
        <div class="hero-content">
          <span class="eyebrow hero-eyebrow">
            <span class="eyebrow-dot"></span>
            CATÁLOGO OFICIAL SIDE QUEST
          </span>

          <h1>
            Sua próxima
            <span>descoberta</span>
            começa aqui.
          </h1>

          <p class="hero-description">
            Explore produtos geek, colecionáveis e itens especiais
            selecionados para quem está sempre atrás de algo novo
            para adicionar à coleção.
          </p>

          <div class="catalog-notice">
            <span class="notice-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  d="M12 3.5 19 7v5.2c0 4.2-2.7 7.3-7 8.8-4.3-1.5-7-4.6-7-8.8V7l7-3.5Z"
                />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>

            <span>
              <strong>Uma vitrine, não um checkout.</strong>
              <small>
                A compra é feita diretamente pelos canais oficiais
                indicados em cada produto.
              </small>
            </span>
          </div>

          <div class="hero-actions">
            <a href="/catalogo/" class="primary-button">
              <span>Explorar catálogo</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>

            <a href="#destaques" class="secondary-button">
              <span>Ver seleção</span>
              <span class="button-arrow" aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="hero-status">
            <span class="status-line"></span>
            <span>Descubra o próximo item da sua coleção.</span>
          </div>
        </div>

        <div
          class="hero-decoration"
          aria-hidden="true"
        >
          <div class="hero-aura aura-one"></div>
          <div class="hero-aura aura-two"></div>
          <div class="hero-aura aura-three"></div>

          <div class="orb orb-one"></div>
          <div class="orb orb-two"></div>
          <div class="orb orb-three"></div>

          <div class="sword-ring ring-one"></div>
          <div class="sword-ring ring-two"></div>
          <div class="sword-ring ring-three"></div>

          <div class="duel-stage">
            <span class="duel-trail trail-left"></span>
            <span class="duel-trail trail-right"></span>

            <svg
              class="duel-swords"
              viewBox="0 0 360 320"
              focusable="false"
            >
              <defs>
                <linearGradient
                  id="bladeCyan"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="1"
                >
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="24%" stop-color="#d9fbff" />
                  <stop offset="55%" stop-color="#5fc8d8" />
                  <stop offset="100%" stop-color="#3f91a5" />
                </linearGradient>

                <linearGradient
                  id="bladeMagenta"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="1"
                >
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="24%" stop-color="#f2d8ff" />
                  <stop offset="55%" stop-color="#b06ac8" />
                  <stop offset="100%" stop-color="#7f4d99" />
                </linearGradient>

                <linearGradient
                  id="guardCyan"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#3f91a5" />
                  <stop offset="45%" stop-color="#5fc8d8" />
                  <stop offset="100%" stop-color="#8de7f2" />
                </linearGradient>

                <linearGradient
                  id="guardMagenta"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#7f4d99" />
                  <stop offset="45%" stop-color="#b06ac8" />
                  <stop offset="100%" stop-color="#df9aed" />
                </linearGradient>

                <linearGradient
                  id="handle"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="1"
                >
                  <stop offset="0%" stop-color="#3c416b" />
                  <stop offset="50%" stop-color="#6879a7" />
                  <stop offset="100%" stop-color="#20243d" />
                </linearGradient>

                <radialGradient id="impactCore">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                  <stop offset="24%" stop-color="#d8fbff" stop-opacity="0.95" />
                  <stop offset="55%" stop-color="#5fc8d8" stop-opacity="0.42" />
                  <stop offset="100%" stop-color="#5fc8d8" stop-opacity="0" />
                </radialGradient>

                <filter
                  id="swordShadow"
                  x="-100%"
                  y="-100%"
                  width="300%"
                  height="300%"
                >
                  <feGaussianBlur
                    in="SourceAlpha"
                    stdDeviation="4"
                    result="blur"
                  />
                  <feOffset dy="2" />
                  <feComponentTransfer>
                    <feFuncA type="linear" slope="0.45" />
                  </feComponentTransfer>
                  <feMerge>
                    <feMergeNode />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>

                <filter
                  id="impactBlur"
                  x="-200%"
                  y="-200%"
                  width="500%"
                  height="500%"
                >
                  <feGaussianBlur stdDeviation="2" />
                </filter>
              </defs>

              <g
                class="sword sword-left"
                filter="url(#swordShadow)"
              >
                <path
                  d="M82 20 L111 49 L95 169 L82 195 L69 169 L53 49 Z"
                  fill="url(#bladeCyan)"
                />

                <path
                  d="M82 24 L82 190"
                  fill="none"
                  stroke="#ffffff"
                  stroke-width="3"
                  stroke-linecap="round"
                  opacity="0.72"
                />

                <path
                  d="M58 49 L82 25 L106 49"
                  fill="none"
                  stroke="#ffffff"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  opacity="0.68"
                />

                <path
                  d="M50 166 Q82 179 114 166"
                  fill="none"
                  stroke="url(#guardCyan)"
                  stroke-width="13"
                  stroke-linecap="round"
                />

                <path
                  d="M54 165 Q82 173 110 165"
                  fill="none"
                  stroke="#c9fbff"
                  stroke-width="2"
                  stroke-linecap="round"
                  opacity="0.85"
                />

                <rect
                  x="71"
                  y="176"
                  width="22"
                  height="55"
                  rx="8"
                  fill="url(#handle)"
                  stroke="#627a9e"
                  stroke-width="3"
                />

                <path
                  d="M72 190 L92 201 M72 207 L92 218"
                  stroke="#a9bee7"
                  stroke-width="3"
                  opacity="0.58"
                />

                <path
                  d="M68 230 L96 230 L82 258 Z"
                  fill="#5fc8d8"
                />

                <circle
                  cx="82"
                  cy="177"
                  r="5"
                  fill="#d9fbff"
                />
              </g>

              <g
                class="sword sword-right"
                filter="url(#swordShadow)"
              >
                <path
                  d="M278 20 L307 49 L291 169 L278 195 L265 169 L249 49 Z"
                  fill="url(#bladeMagenta)"
                />

                <path
                  d="M278 24 L278 190"
                  fill="none"
                  stroke="#ffffff"
                  stroke-width="3"
                  stroke-linecap="round"
                  opacity="0.72"
                />

                <path
                  d="M254 49 L278 25 L302 49"
                  fill="none"
                  stroke="#ffffff"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  opacity="0.68"
                />

                <path
                  d="M246 166 Q278 179 310 166"
                  fill="none"
                  stroke="url(#guardMagenta)"
                  stroke-width="13"
                  stroke-linecap="round"
                />

                <path
                  d="M250 165 Q278 173 306 165"
                  fill="none"
                  stroke="#f5dcff"
                  stroke-width="2"
                  stroke-linecap="round"
                  opacity="0.85"
                />

                <rect
                  x="267"
                  y="176"
                  width="22"
                  height="55"
                  rx="8"
                  fill="url(#handle)"
                  stroke="#8f70bd"
                  stroke-width="3"
                />

                <path
                  d="M268 190 L288 201 M268 207 L288 218"
                  stroke="#c3b1e8"
                  stroke-width="3"
                  opacity="0.58"
                />

                <path
                  d="M264 230 L292 230 L278 258 Z"
                  fill="#b06ac8"
                />

                <circle
                  cx="278"
                  cy="177"
                  r="5"
                  fill="#f2d8ff"
                />
              </g>

              <g class="impact">
                <circle
                  cx="180"
                  cy="100"
                  r="62"
                  fill="url(#impactCore)"
                />

                <circle
                  cx="180"
                  cy="100"
                  r="12"
                  fill="#ffffff"
                  opacity="0.9"
                />

                <path
                  d="M180 29 L180 0 M180 171 L180 200
                     M109 100 L79 100 M251 100 L281 100
                     M130 50 L109 29 M230 50 L251 29
                     M130 150 L109 171 M230 150 L251 171"
                  fill="none"
                  stroke="#d9fbff"
                  stroke-width="3"
                  stroke-linecap="round"
                />

                <path
                  d="M180 42 L188 82 L218 100 L188 108 L180 151
                     L172 108 L142 100 L172 82 Z"
                  fill="none"
                  stroke="#ffffff"
                  stroke-width="2"
                  opacity="0.78"
                />
              </g>

              <g class="spark spark-one">
                <path d="M180 16 L180 30 M173 23 L187 23" />
              </g>

              <g class="spark spark-two">
                <path d="M82 89 L82 103 M75 96 L89 96" />
              </g>

              <g class="spark spark-three">
                <path d="M278 89 L278 103 M271 96 L285 96" />
              </g>
            </svg>
          </div>

          <div class="hero-emblem">
            <span>✦</span>
            <span>QUEST</span>
            <span>✦</span>
          </div>
        </div>
      </div>
    </section>

    <section class="categories-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">
              <span class="eyebrow-dot"></span>
              EXPLORE
            </span>

            <h2>Encontre sua próxima descoberta</h2>
          </div>

          <a href="/catalogo/" class="section-link">
            Ver tudo <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="section-intro">
          Daquele item que você estava procurando àquela peça que
          simplesmente precisava entrar para a coleção.
        </p>

        <div class="category-grid">
          {activeCategories.map((category, index) => (
            <a
              href={`/catalogo/?categoria=${category.slug}`}
              class={`category-card category-card-${(index % 4) + 1}`}
            >
              <span class="category-icon" aria-hidden="true">
                <span class="category-icon-mark">
                  {index % 4 === 0 ? '◇' : index % 4 === 1 ? '✦' : index % 4 === 2 ? '◈' : '＋'}
                </span>
              </span>

              <strong>{category.name}</strong>

              {category.description && (
                <p>{category.description}</p>
              )}

              <span class="category-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="featured-section" id="destaques">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">
              <span class="eyebrow-dot"></span>
              SELEÇÃO SIDE QUEST
            </span>

            <h2>Itens que merecem atenção</h2>
          </div>

          <a href="/catalogo/" class="section-link">
            Ver catálogo <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="section-intro">
          Uma seleção de peças para começar sua próxima quest —
          ou encontrar aquela que estava faltando.
        </p>

        {featuredProducts.length > 0 ? (
          <div class="product-grid">
            {featuredProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <p class="empty-message">
            Nenhum produto em destaque no momento.
          </p>
        )}
      </div>
    </section>

    <OfficialChannels />
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 76% 42%,
        rgba(118, 103, 168, 0.15),
        transparent 28%
      ),
      radial-gradient(
        circle at 96% 12%,
        rgba(95, 200, 216, 0.06),
        transparent 22%
      ),
      radial-gradient(
        circle at 10% 85%,
        rgba(176, 106, 200, 0.045),
        transparent 25%
      );
  }

  .hero-inner {
    position: relative;
    display: grid;
    min-height: 620px;
    align-items: center;
    padding-top: 70px;
    padding-bottom: 70px;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        rgba(145, 134, 189, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(145, 134, 189, 0.035) 1px,
        transparent 1px
      );
    background-size: 42px 42px;
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.8),
      transparent 90%
    );
    opacity: 0.55;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    pointer-events: none;
  }

  .hero-glow-purple {
    top: -140px;
    right: 10%;
    width: 360px;
    height: 360px;
    background: rgba(118, 103, 168, 0.11);
    animation: hero-glow-pulse 7s ease-in-out infinite;
  }

  .hero-glow-cyan {
    right: -120px;
    bottom: -160px;
    width: 360px;
    height: 360px;
    background: rgba(95, 200, 216, 0.065);
    animation: hero-glow-pulse 9s ease-in-out infinite reverse;
  }

  .hero-glow-magenta {
    top: 38%;
    left: -180px;
    width: 280px;
    height: 280px;
    background: rgba(176, 106, 200, 0.05);
    animation: hero-glow-pulse 11s ease-in-out infinite;
  }

  .hero-glow-gold {
    top: 16%;
    right: 36%;
    width: 150px;
    height: 150px;
    background: rgba(213, 168, 92, 0.035);
    animation: hero-glow-pulse 8s ease-in-out infinite reverse;
  }

  .hero-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 12px rgba(95, 200, 216, 0.5);
    opacity: 0.55;
    animation: particle-float 6s ease-in-out infinite;
  }

  .particle-one {
    top: 20%;
    left: 44%;
  }

  .particle-two {
    top: 68%;
    left: 52%;
    width: 3px;
    height: 3px;
    background: var(--color-magenta);
    box-shadow: 0 0 12px rgba(176, 106, 200, 0.5);
    animation-delay: -2s;
  }

  .particle-three {
    top: 32%;
    right: 18%;
    width: 3px;
    height: 3px;
    background: var(--color-gold);
    box-shadow: 0 0 12px rgba(213, 168, 92, 0.45);
    animation-delay: -4s;
  }

  .particle-four {
    bottom: 18%;
    right: 34%;
    width: 2px;
    height: 2px;
    animation-delay: -1s;
  }

  .particle-five {
    top: 14%;
    right: 38%;
    width: 2px;
    height: 2px;
    background: var(--color-magenta);
    box-shadow: 0 0 10px rgba(176, 106, 200, 0.4);
    animation-delay: -3s;
  }

  .particle-six {
    top: 55%;
    left: 31%;
    width: 2px;
    height: 2px;
    background: var(--color-gold);
    box-shadow: 0 0 10px rgba(213, 168, 92, 0.4);
    animation-delay: -5s;
  }

  .particle-seven {
    bottom: 28%;
    left: 12%;
    width: 3px;
    height: 3px;
    background: var(--color-cyan);
    animation-delay: -1.5s;
  }

  .particle-eight {
    top: 23%;
    right: 8%;
    width: 2px;
    height: 2px;
    background: var(--color-primary-light);
    box-shadow: 0 0 10px rgba(145, 134, 189, 0.45);
    animation-delay: -4.5s;
  }

  .hero-rune {
    position: absolute;
    color: var(--color-primary-light);
    font-size: 1rem;
    opacity: 0.22;
    animation: rune-drift 8s ease-in-out infinite;
  }

  .rune-one {
    top: 24%;
    left: 18%;
  }

  .rune-two {
    top: 64%;
    right: 42%;
    color: var(--color-cyan);
    animation-delay: -3s;
  }

  .rune-three {
    bottom: 16%;
    right: 17%;
    color: var(--color-gold);
    animation-delay: -5s;
  }

  .hero-content {
    position: relative;
    z-index: 4;
    max-width: 700px;
    animation: hero-content-in 850ms cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: 250ms;
  }

  .hero-eyebrow {
    animation: eyebrow-enter 700ms ease both;
    animation-delay: 150ms;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary-light);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 10px rgba(95, 200, 216, 0.55);
    animation: eyebrow-pulse 3s ease-in-out infinite;
  }

  h1 {
    max-width: 720px;
    margin: 16px 0 20px;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    background: linear-gradient(
      100deg,
      #a999ed 0%,
      #8c7ad0 30%,
      #68bfd0 62%,
      #b06ac8 82%,
      #a999ed 100%
    );
    background-size: 220% auto;
    background-clip: text;
    color: transparent;
    animation: title-shimmer 8s ease-in-out infinite;
  }

  .hero-description {
    max-width: 580px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.72;
  }

  .catalog-notice {
    display: flex;
    max-width: 580px;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 12px 14px;
    border: 1px solid rgba(95, 200, 216, 0.12);
    border-radius: var(--radius-md);
    background:
      linear-gradient(
        110deg,
        rgba(95, 200, 216, 0.055),
        rgba(118, 103, 168, 0.055)
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.025);
    animation: notice-enter 750ms ease both;
    animation-delay: 500ms;
  }

  .notice-icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid rgba(95, 200, 216, 0.2);
    border-radius: 9px;
    background: rgba(95, 200, 216, 0.07);
    color: var(--color-cyan);
  }

  .notice-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .catalog-notice strong,
  .catalog-notice small {
    display: block;
  }

  .catalog-notice strong {
    color: var(--color-text);
    font-size: 0.82rem;
  }

  .catalog-notice small {
    margin-top: 3px;
    color: var(--color-text-soft);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .primary-button,
  .secondary-button {
    position: relative;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    overflow: hidden;
    padding: 0 20px;
    border-radius: var(--radius-md);
    font-weight: 800;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base);
  }

.primary-button {
    background:
      linear-gradient(
        110deg,
        #7667a8 0%,
        #806db7 35%,
        #6f8ab4 68%,
        #5f9fb1 100%
      );
    color: #f7f5ff;
    box-shadow:
      0 8px 24px rgba(118, 103, 168, 0.2);
  }

  .primary-button::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.15) 50%,
      transparent 70%
    );
    content: "";
    transform: translateX(-120%);
    transition: transform 600ms ease;
  }

  .primary-button:hover {
    transform: translateY(-3px);
    box-shadow:
      0 12px 30px rgba(118, 103, 168, 0.28),
      0 0 24px rgba(95, 200, 216, 0.08);
  }

  .primary-button:hover::before {
    transform: translateX(120%);
  }

  .secondary-button {
    border: 1px solid var(--color-border-strong);
