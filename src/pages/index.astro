---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import OfficialChannels from '../components/OfficialChannels.astro';
import { products } from '../data/products';
import { categories } from '../data/categories';

const featuredProducts = products.filter(
  (product) => product.featured && product.status !== 'oculto'
);

const activeCategories = categories.filter(
  (category) => category.active
);
---

<Layout
  title="Side Quest — Catálogo Geek"
  description="Descubra pelúcias, chaveiros, colecionáveis e produtos geek no catálogo oficial da Side Quest."
>
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-content">
          <span class="eyebrow">CATÁLOGO OFICIAL</span>

          <h1>
            Encontre algo que
            <span>merece entrar</span>
            na sua coleção.
          </h1>

          <p>
            Produtos geek, colecionáveis e itens especiais selecionados
            pela Side Quest.
          </p>

          <div class="hero-actions">
            <a href="/catalogo/" class="primary-button">
              Explorar catálogo
            </a>

            <a href="#destaques" class="secondary-button">
              Ver destaques
            </a>
          </div>
        </div>

        <div class="hero-decoration" aria-hidden="true">
          <div class="orb orb-one"></div>
          <div class="orb orb-two"></div>
          <div class="hero-symbol">SQ</div>
        </div>
      </div>
    </section>

    <section class="categories-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">EXPLORE</span>
            <h2>Categorias</h2>
          </div>

          <a href="/catalogo/">Ver tudo →</a>
        </div>

        <div class="category-grid">
          {activeCategories.map((category) => (
            <a
              href={`/catalogo/?categoria=${category.slug}`}
              class="category-card"
            >
              <span class="category-icon" aria-hidden="true">
                ✦
              </span>

              <strong>{category.name}</strong>

              {category.description && (
                <p>{category.description}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="featured-section" id="destaques">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">EM DESTAQUE</span>
            <h2>Escolhas da Side Quest</h2>
          </div>

          <a href="/catalogo/">Ver catálogo →</a>
        </div>

        {featuredProducts.length > 0 ? (
          <div class="product-grid">
            {featuredProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <p class="empty-message">
            Nenhum produto em destaque no momento.
          </p>
        )}
      </div>
    </section>

    <OfficialChannels />
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    position: relative;
    display: grid;
    min-height: 580px;
    align-items: center;
    padding-top: 70px;
    padding-bottom: 70px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  h1 {
    max-width: 720px;
    margin: 16px 0 20px;
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    background: linear-gradient(
      100deg,
      var(--color-primary-light),
      var(--color-primary),
      var(--color-accent)
    );
    background-clip: text;
    color: transparent;
  }

  .hero-content > p {
    max-width: 580px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: var(--radius-md);
    font-weight: 800;
  }

  .primary-button {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .secondary-button {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .hero-decoration {
    position: absolute;
    top: 50%;
    right: -90px;
    width: 430px;
    height: 430px;
    transform: translateY(-50%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .orb-one {
    inset: 50px;
    background: rgba(145, 134, 189, 0.1);
  }

  .orb-two {
    inset: 110px;
    background: rgba(98, 122, 158, 0.12);
  }

  .hero-symbol {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(228, 229, 236, 0.1);
    font-size: 9rem;
    font-weight: 950;
  }

  .categories-section,
  .featured-section {
    padding: 76px 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 8px 0 0;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
  }

  .section-heading > a {
    color: var(--color-primary-light);
    font-weight: 700;
    white-space: nowrap;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .category-card {
    min-height: 145px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-3px);
    border-color: rgba(145, 134, 189, 0.35);
  }

  .category-icon {
    display: grid;
    width: 34px;
    height: 34px;
    margin-bottom: 20px;
    place-items: center;
    border-radius: 9px;
    background: var(--color-surface-soft);
    color: var(--color-primary);
  }

  .category-card strong {
    display: block;
  }

  .category-card p {
    margin: 7px 0 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .empty-message {
    padding: 30px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 700px) {
    .category-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .hero-inner {
      min-height: 650px;
    }

    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .hero-inner {
      min-height: 600px;
    }

    .hero-decoration {
      top: auto;
      right: -140px;
      bottom: -150px;
      transform: none;
      opacity: 0.7;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
