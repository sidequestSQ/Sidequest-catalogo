---
import type { Product } from '../types/catalog';

import { formatPrice } from '../utils/price';
import { getCategoryName } from '../utils/products';
import {
  getProductStatusLabel,
  isProductAvailable,
} from '../utils/status';
import { getPrimaryProductImage } from '../utils/images';
import { getProductPrice } from '../utils/promotions';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const image = getPrimaryProductImage(product);

const categoryName = getCategoryName(
  product.categoryId
);

const statusLabel = getProductStatusLabel(
  product.status
);

const available = isProductAvailable(
  product.status
);

const price = getProductPrice(product);
---

<article class="product-card">
  <a
    href={`/produto/${product.slug}/`}
    class="product-link"
    aria-label={`Ver ${product.name}`}
  >
    <div class="product-image">
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
        />
      ) : (
        <span class="no-image">
          Sem imagem
        </span>
      )}

      <div
        class="image-overlay"
        aria-hidden="true"
      ></div>

      <div
        class="image-shine"
        aria-hidden="true"
      ></div>

      <div
        class="image-frame"
        aria-hidden="true"
      >
        <span class="frame-corner corner-top"></span>
        <span class="frame-corner corner-bottom"></span>
      </div>

      <div
        class="image-index"
        aria-hidden="true"
      >
        <span>01</span>
        <i></i>
      </div>

      {product.status !== 'disponivel' && (
        <span class="status-badge">
          <span class="badge-dot"></span>
          {statusLabel}
        </span>
      )}

      {price.discountCents > 0 && (
        <span class="discount-badge">
          <span class="discount-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 7h.01" />
              <path d="m7 3 4-1 10 10-8 8L3 10V6z" />
              <path d="m8 16 8-8" />
            </svg>
          </span>

          -{price.discountPercent}%
        </span>
      )}

      <span
        class="product-arrow"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </span>
    </div>

    <div class="product-content">
      <div class="product-category">
        <span class="category-marker"></span>

        <span>{categoryName}</span>

        <span class="category-line"></span>
      </div>

      <h2>{product.name}</h2>

      <p class="product-description">
        {product.shortDescription}
      </p>

      <div class="product-footer">
        <div class="price-area">
          {price.discountCents > 0 && (
            <span class="old-price">
              {formatPrice(
                price.originalPriceCents
              )}
            </span>
          )}

          <strong class="product-price">
            {formatPrice(
              price.finalPriceCents
            )}
          </strong>

          {price.discountCents > 0 && (
            <span class="saving-label">
              Você economiza
              {` ${formatPrice(price.discountCents)}`}
            </span>
          )}
        </div>

        <span
          class:list={{
            availability: true,
            'availability-available':
              available,
          }}
        >
          <span class="availability-dot"></span>

          {available
            ? 'Disponível'
            : statusLabel}
        </span>
      </div>

      <div
        class="product-hint"
        aria-hidden="true"
      >
        <span>Ver detalhes</span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </div>
    </div>
  </a>
</article>

<style>
  /* =====================================================
     CARD
     ===================================================== */

  .product-card {
    position: relative;

    overflow: hidden;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        rgba(41, 46, 67, 0.96),
        rgba(24, 28, 45, 0.99) 58%,
        rgba(20, 23, 38, 0.99)
      );

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);

    transition:
      transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 320ms ease,
      box-shadow 420ms ease;
  }

  .product-card::before {
    position: absolute;

    top: -100px;
    right: -90px;

    width: 210px;
    height: 210px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(95, 200, 216, 0.12),
        rgba(95, 200, 216, 0.025) 42%,
        transparent 70%
      );

    filter: blur(20px);

    content: "";

    opacity: 0;

    transform: scale(0.7);

    pointer-events: none;

    transition:
      opacity 500ms ease,
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .product-card::after {
    position: absolute;

    right: 0;
    bottom: 0;
    left: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(95, 200, 216, 0.22),
        rgba(176, 106, 200, 0.2),
        transparent
      );

    content: "";

    opacity: 0.5;

    transition:
      opacity 320ms ease;
  }

  .product-card:hover {
    transform: translateY(-6px);

    border-color:
      rgba(95, 200, 216, 0.25);

    box-shadow:
      0 20px 42px rgba(0, 0, 0, 0.25),
      0 0 28px rgba(95, 200, 216, 0.06);
  }

  .product-card:hover::before {
    opacity: 1;
    transform: scale(1.15);
  }

  .product-card:hover::after {
    opacity: 1;
  }

  .product-link {
    display: block;
  }


  /* =====================================================
     IMAGEM
     ===================================================== */

  .product-image {
    position: relative;

    display: grid;

    aspect-ratio: 1 / 1;

    place-items: center;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 50% 38%,
        rgba(118, 103, 168, 0.19),
        transparent 50%
      ),
      radial-gradient(
        circle at 78% 82%,
        rgba(95, 200, 216, 0.07),
        transparent 35%
      ),
      linear-gradient(
        145deg,
        #252a3d,
        #1b1f31
      );

    color: var(--color-text-muted);
  }

  .product-image::before {
    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.025),
        transparent 28%,
        transparent 72%,
        rgba(176, 106, 200, 0.035)
      );

    content: "";

    pointer-events: none;
  }

  .product-image img {
    position: relative;

    z-index: 1;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 500ms ease;
  }

  .product-card:hover
  .product-image img {
    transform: scale(1.065);

    filter:
      saturate(1.07)
      brightness(1.035);
  }

  .image-overlay {
    position: absolute;

    inset: 0;

    z-index: 2;

    background:
      linear-gradient(
        180deg,
        rgba(10, 12, 22, 0.05) 0%,
        transparent 46%,
        rgba(10, 12, 22, 0.34) 100%
      );

    pointer-events: none;

    transition:
      opacity 400ms ease;
  }

  .product-card:hover
  .image-overlay {
    opacity: 0.82;
  }

  .image-shine {
    position: absolute;

    top: -30%;
    left: -80%;

    z-index: 3;

    width: 42%;
    height: 170%;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.08),
        transparent
      );

    transform: rotate(18deg);

    pointer-events: none;
  }

  .product-card:hover
  .image-shine {
    animation:
      image-shine-pass 850ms ease forwards;
  }

  @keyframes image-shine-pass {
    from {
      left: -80%;
    }

    to {
      left: 135%;
    }
  }


  /* =====================================================
     MOLDURA
     ===================================================== */

  .image-frame {
    position: absolute;

    inset: 8px;

    z-index: 4;

    border: 1px solid
      rgba(255, 255, 255, 0.045);

    border-radius: 11px;

    pointer-events: none;
  }

  .frame-corner {
    position: absolute;

    width: 21px;
    height: 21px;

    opacity: 0.7;
  }

  .corner-top {
    top: -1px;
    left: -1px;

    border-top: 1px solid
      rgba(95, 200, 216, 0.3);

    border-left: 1px solid
      rgba(95, 200, 216, 0.3);

    border-radius: 7px 0 0 0;
  }

  .corner-bottom {
    right: -1px;
    bottom: -1px;

    border-right: 1px solid
      rgba(176, 106, 200, 0.28);

    border-bottom: 1px solid
      rgba(176, 106, 200, 0.28);

    border-radius: 0 0 7px 0;
  }


  /* =====================================================
     ÍNDICE VISUAL
     ===================================================== */

  .image-index {
    position: absolute;

    top: 12px;
    right: 13px;

    z-index: 5;

    display: flex;

    align-items: center;

    gap: 6px;

    color: rgba(228, 229, 236, 0.65);

    font-size: 0.52rem;
    font-weight: 850;

    letter-spacing: 0.12em;

    opacity: 0.72;
  }

  .image-index i {
    display: block;

    width: 18px;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        var(--color-cyan),
        transparent
      );

    opacity: 0.6;
  }


  /* =====================================================
     BADGES
     ===================================================== */

  .status-badge,
  .discount-badge {
    position: absolute;

    top: 11px;

    z-index: 6;

    display: inline-flex;

    min-height: 27px;

    align-items: center;

    border-radius: var(--radius-pill);

    font-size: 0.63rem;
    font-weight: 850;

    letter-spacing: 0.015em;

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .status-badge {
    left: 11px;

    gap: 6px;

    padding: 4px 9px;

    border: 1px solid
      rgba(220, 224, 240, 0.13);

    background:
      rgba(16, 19, 34, 0.86);

    color: var(--color-text);
  }

  .badge-dot {
    width: 5px;
    height: 5px;

    flex: 0 0 5px;

    border-radius: 50%;

    background: var(--color-cyan);

    box-shadow:
      0 0 8px
      rgba(95, 200, 216, 0.5);
  }

  .discount-badge {
    right: 11px;

    gap: 5px;

    padding: 4px 9px;

    border: 1px solid
      rgba(213, 168, 92, 0.26);

    background:
      linear-gradient(
        135deg,
        rgba(213, 168, 92, 0.96),
        rgba(176, 106, 200, 0.94)
      );

    box-shadow:
      0 5px 16px
      rgba(176, 106, 200, 0.16);

    color: #171827;
  }

  .discount-icon {
    display: grid;

    width: 12px;
    height: 12px;

    place-items: center;
  }

  .discount-icon svg {
    width: 12px;
    height: 12px;
  }

  .product-card:hover
  .discount-badge {
    transform: translateY(-1px);
    box-shadow:
      0 7px 19px
      rgba(176, 106, 200, 0.2);
  }


  /* =====================================================
     SETA
     ===================================================== */

  .product-arrow {
    position: absolute;

    right: 11px;
    bottom: 11px;

    z-index: 7;

    display: grid;

    width: 34px;
    height: 34px;

    place-items: center;

    border: 1px solid
      rgba(95, 200, 216, 0.22);

    border-radius: 50%;

    background:
      rgba(16, 19, 34, 0.82);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    color: var(--color-cyan);

    opacity: 0;

    transform:
      translate(6px, 6px)
      scale(0.84);

    transition:
      opacity 300ms ease,
      transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1),
      background 300ms ease;
  }

  .product-arrow svg {
    width: 15px;
    height: 15px;
  }

  .product-card:hover
  .product-arrow {
    opacity: 1;

    transform:
      translate(0, 0)
      scale(1);
  }

  .product-card:hover
  .product-arrow {
    background:
      rgba(28, 32, 50, 0.94);
  }


  /* =====================================================
     CONTEÚDO
     ===================================================== */

  .product-content {
    position: relative;

    padding: 17px 16px 15px;
  }

  .product-category {
    display: flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 7px;

    color: var(--color-primary-light);

    font-size: 0.61rem;
    font-weight: 850;

    text-transform: uppercase;

    letter-spacing: 0.095em;
  }

  .category-marker {
    width: 6px;
    height: 6px;

    flex: 0 0 6px;

    border: 1px solid
      var(--color-magenta);

    border-radius: 1px;

    background:
      rgba(176, 106, 200, 0.16);

    box-shadow:
      0 0 8px
      rgba(176, 106, 200, 0.3);

    transform: rotate(45deg);
  }

  .category-line {
    width: 24px;
    height: 1px;

    margin-left: 2px;

    background:
      linear-gradient(
        90deg,
        rgba(118, 103, 168, 0.4),
        transparent
      );
  }

  .product-content h2 {
    display: -webkit-box;

    margin: 0;

    overflow: hidden;

    color: var(--color-text-strong);

    font-size: 0.98rem;

    line-height: 1.28;

    letter-spacing: -0.014em;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    transition:
      color 300ms ease;
  }

  .product-card:hover
  .product-content h2 {
    color: #f3f2fa;
  }

  .product-description {
    display: -webkit-box;

    margin: 7px 0 14px;

    overflow: hidden;

    color: var(--color-text-muted);

    font-size: 0.76rem;

    line-height: 1.48;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }


  /* =====================================================
     RODAPÉ
     ===================================================== */

  .product-footer {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 10px;

    padding-top: 12px;

    border-top: 1px solid
      rgba(220, 224, 240, 0.08);
  }

  .price-area {
    display: flex;

    min-width: 0;

    flex-direction: column;

    gap: 2px;
  }

  .old-price {
    color: var(--color-text-soft);

    font-size: 0.66rem;

    line-height: 1.1;

    text-decoration: line-through;
  }

  .product-price {
    color: #f0eef8;

    font-size: 1.1rem;

    line-height: 1.15;

    white-space: nowrap;

    letter-spacing: -0.015em;
  }

  .saving-label {
    color: var(--color-gold);

    font-size: 0.55rem;
    font-weight: 750;

    line-height: 1.2;
  }

  .availability {
    display: inline-flex;

    max-width: 48%;

    align-items: center;

    gap: 5px;

    padding-bottom: 2px;

    color: var(--color-text-muted);

    font-size: 0.61rem;
    font-weight: 800;

    line-height: 1.2;

    text-align: right;
  }

  .availability-available {
    color: var(--color-success);
  }

  .availability-dot {
    width: 5px;
    height: 5px;

    flex: 0 0 5px;

    border-radius: 50%;

    background: currentColor;
  }

  .availability-available
  .availability-dot {
    box-shadow:
      0 0 8px
      rgba(117, 165, 138, 0.55);

    animation:
      availability-pulse
      3s ease-in-out infinite;
  }


  /* =====================================================
     HINT
     ===================================================== */

  .product-hint {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 5px;

    margin-top: 12px;

    color: var(--color-text-soft);

    font-size: 0.58rem;
    font-weight: 750;

    letter-spacing: 0.035em;

    opacity: 0.72;

    transition:
      color 300ms ease,
      opacity 300ms ease;
  }

  .product-hint svg {
    width: 12px;
    height: 12px;

    transition:
      transform 300ms ease;
  }

  .product-card:hover
  .product-hint {
    color: var(--color-cyan);
    opacity: 1;
  }

  .product-card:hover
  .product-hint svg {
    transform: translateX(3px);
  }


  /* =====================================================
     ANIMAÇÃO
     ===================================================== */

  @keyframes availability-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.9);
    }

    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 480px) {
    .product-card {
      border-radius: var(--radius-md);
    }

    .product-content {
      padding: 14px 12px 12px;
    }

    .product-category {
      margin-bottom: 5px;

      font-size: 0.57rem;
    }

    .category-line {
      width: 16px;
    }

    .product-content h2 {
      font-size: 0.88rem;
    }

    .product-description {
      margin-top: 5px;
      margin-bottom: 11px;

      font-size: 0.7rem;
      line-height: 1.42;
    }

    .product-footer {
      gap: 7px;
    }

    .product-price {
      font-size: 1rem;
    }

    .saving-label {
      font-size: 0.52rem;
    }

    .availability {
      max-width: 46%;

      font-size: 0.56rem;
    }

    .status-badge,
    .discount-badge {
      top: 8px;

      min-height: 23px;

      padding: 3px 7px;

      font-size: 0.56rem;
    }

    .status-badge {
      left: 8px;
    }

    .discount-badge {
      right: 8px;
    }

    .image-index {
      top: 10px;
      right: 10px;

      font-size: 0.48rem;
    }

    .image-frame {
      inset: 6px;
    }

    .product-arrow {
      right: 8px;
      bottom: 8px;

      width: 29px;
      height: 29px;
    }

    .product-hint {
      margin-top: 10px;

      font-size: 0.54rem;
    }

    .product-hint svg {
      width: 11px;
      height: 11px;
    }
  }


  /* =====================================================
     REDUÇÃO DE MOVIMENTO
     ===================================================== */

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card::before,
    .product-card::after,
    .product-image img,
    .image-overlay,
    .image-shine,
    .product-arrow,
    .product-content h2,
    .product-hint,
    .product-hint svg,
    .discount-badge {
      transition: none;
      animation: none;
    }

    .availability-available
    .availability-dot {
      animation: none;
    }
  }
</style>
