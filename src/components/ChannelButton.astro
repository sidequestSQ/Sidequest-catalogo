---
import type { OfficialChannel } from '../types/catalog';
import { isValidOfficialChannel } from '../utils/channels';

interface Props {
  channel: OfficialChannel;
  productName?: string;
  message?: string;
  price?: string;
  categoryName?: string;
  sku?: string;
}

const {
  channel,
  productName,
  message,
  price,
  categoryName,
  sku,
} = Astro.props;

const defaultMessages = {
  divulgacao:
    'Conheça a Side Quest no Instagram.',

  contato: productName
    ? `Olá! Gostaria de saber mais sobre o produto ${productName}.`
    : 'Olá! Gostaria de saber mais sobre um produto da Side Quest.',

  venda: productName
    ? `Olá! Tenho interesse em comprar o produto ${productName}.`
    : 'Olá! Tenho interesse em um produto da Side Quest.',
};

const template =
  message?.trim() ||
  defaultMessages[channel.purpose];

const channelMessage = template
  .replaceAll('{produto}', productName ?? '')
  .replaceAll('{preço}', price ?? '')
  .replaceAll('{categoria}', categoryName ?? '')
  .replaceAll('{sku}', sku ?? '');

const isValidChannel =
  isValidOfficialChannel(channel);

let href = channel.url;

if (channel.type === 'whatsapp' && isValidChannel) {
  const separator = channel.url.includes('?')
    ? '&'
    : '?';

  href =
    `${channel.url}${separator}` +
    `text=${encodeURIComponent(channelMessage)}`;
}

const labels = {
  divulgacao: 'Conhecer canal',
  contato: 'Falar com a Side Quest',
  venda: 'Comprar',
};

const label = labels[channel.purpose];

const isWhatsApp =
  channel.type === 'whatsapp';

const isInstagram =
  channel.type === 'instagram';

const channelTypeLabel =
  isWhatsApp
    ? 'Atendimento direto'
    : isInstagram
      ? 'Rede social'
      : 'Canal oficial';

const contextText =
  channel.purpose === 'venda'
    ? 'Entre em contato para saber mais e realizar sua compra.'
    : channel.purpose === 'contato'
      ? 'Tire dúvidas e converse com a Side Quest sobre este produto.'
      : 'Acompanhe novidades e conteúdos da Side Quest.';
---

{isValidChannel && (
  <a
    class:list={{
      'channel-button': true,
      'channel-whatsapp': isWhatsApp,
      'channel-instagram': isInstagram,
    }}
    href={href}
    target="_blank"
    rel="noopener noreferrer"
  >
    <div class="channel-background" aria-hidden="true"></div>

    <div class="channel-top">
      <span class="channel-official">
        <span class="official-dot"></span>
        Canal oficial
      </span>

      <span class="channel-type">
        {channelTypeLabel}
      </span>
    </div>

    <div class="channel-main">
      <div class="channel-icon" aria-hidden="true">
        {isInstagram ? (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
            />
            <circle cx="12" cy="12" r="4.2" />
            <circle
              cx="17.4"
              cy="6.7"
              r="0.8"
              fill="currentColor"
              stroke="none"
            />
          </svg>
        ) : isWhatsApp ? (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M20.1 3.9A10.1 10.1 0 0 0 12.9 1C7.3.6 2.2 4.8 1.6 10.4c-.2 2.1.3 4.2 1.4 6L1.5 23l6.8-1.8a10.8 10.8 0 0 0 4.7 1.1h.1c5.7 0 10.4-4.6 10.4-10.3 0-3-1.2-5.9-3.4-8.1Z"
            />
            <path
              d="M8.5 7.5c.2-.4.5-.4.8-.4h.6c.2 0 .4.1.5.4l.9 2.1c.1.3.1.5-.1.7l-.7.9c.8 1.5 2 2.6 3.5 3.4l.8-.7c.2-.2.5-.2.8-.1l2 .9c.3.1.4.3.4.6v.6c0 .3-.1.6-.4.8-.5.4-1.2.6-1.8.5-1.8-.2-3.7-1-5.2-2.3-1.4-1.2-2.5-2.8-3.2-4.5-.3-.8-.4-1.6-.2-2.4.1-.2.2-.4.3-.5Z"
            />
          </svg>
        ) : (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        )}
      </div>

      <div class="channel-info">
        <span class="channel-name">
          {channel.name}
        </span>

        <span class="channel-context">
          {productName
            ? `Sobre: ${productName}`
            : 'Sobre este produto'}
        </span>
      </div>
    </div>

    <div class="channel-bottom">
      <span class="channel-description">
        {contextText}
      </span>

      <span class="channel-action">
        <span>{label}</span>

        <span class="action-arrow" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h13" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </span>
      </span>
    </div>

    <span class="channel-corner corner-top" aria-hidden="true"></span>
    <span class="channel-corner corner-bottom" aria-hidden="true"></span>
  </a>
)}

<style>
  .channel-button {
    position: relative;

    display: block;

    min-height: 174px;

    overflow: hidden;

    padding: 18px;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        rgba(41, 46, 67, 0.96),
        rgba(24, 28, 45, 0.99)
      );

    color: var(--color-text);

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);

    transition:
      transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  .channel-button:hover {
    transform: translateY(-4px);

    border-color:
      rgba(95, 200, 216, 0.25);

    box-shadow:
      0 17px 34px rgba(0, 0, 0, 0.22),
      0 0 24px rgba(95, 200, 216, 0.05);
  }

  .channel-background {
    position: absolute;

    top: -100px;
    right: -90px;

    width: 240px;
    height: 240px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(95, 200, 216, 0.1),
        transparent 68%
      );

    opacity: 0.75;

    transition:
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 400ms ease;

    pointer-events: none;
  }

  .channel-whatsapp .channel-background {
    background:
      radial-gradient(
        circle,
        rgba(117, 165, 138, 0.11),
        transparent 68%
      );
  }

  .channel-button:hover .channel-background {
    opacity: 1;
    transform: scale(1.18);
  }

  .channel-top {
    position: relative;
    z-index: 2;

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 17px;
  }

  .channel-official,
  .channel-type {
    font-size: 0.56rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .channel-official {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: var(--color-success);
  }

  .official-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: currentColor;

    box-shadow:
      0 0 8px rgba(117, 165, 138, 0.5);
  }

  .channel-type {
    color: var(--color-text-soft);
  }

  .channel-main {
    position: relative;
    z-index: 2;

    display: flex;

    align-items: center;

    gap: 13px;
  }

  .channel-icon {
    display: grid;

    flex: 0 0 49px;

    width: 49px;
    height: 49px;

    place-items: center;

    border: 1px solid
      rgba(145, 134, 189, 0.2);

    border-radius: 14px;

    background:
      linear-gradient(
        145deg,
        rgba(118, 103, 168, 0.16),
        rgba(95, 200, 216, 0.07)
      );

    color: var(--color-primary-light);

    transition:
      transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 300ms ease;
  }

  .channel-whatsapp .channel-icon {
    border-color:
      rgba(117, 165, 138, 0.2);

    background:
      linear-gradient(
        145deg,
        rgba(117, 165, 138, 0.13),
        rgba(95, 200, 216, 0.05)
      );

    color: var(--color-success);
  }

  .channel-icon svg {
    width: 24px;
    height: 24px;
  }

  .channel-button:hover .channel-icon {
    transform:
      translateY(-2px)
      rotate(-3deg);

    border-color:
      rgba(95, 200, 216, 0.32);
  }

  .channel-whatsapp:hover .channel-icon {
    border-color:
      rgba(117, 165, 138, 0.34);
  }

  .channel-info {
    min-width: 0;
  }

  .channel-name {
    display: block;

    overflow: hidden;

    color: var(--color-text-strong);

    font-size: 1rem;
    font-weight: 850;

    line-height: 1.2;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .channel-context {
    display: block;

    margin-top: 4px;

    overflow: hidden;

    color: var(--color-text-soft);

    font-size: 0.64rem;

    line-height: 1.35;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .channel-bottom {
    position: relative;
    z-index: 2;

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 14px;

    margin-top: 18px;

    padding-top: 13px;

    border-top: 1px solid
      rgba(220, 224, 240, 0.07);
  }

  .channel-description {
    max-width: 54%;

    color: var(--color-text-muted);

    font-size: 0.64rem;

    line-height: 1.4;
  }

  .channel-action {
    display: inline-flex;

    flex-shrink: 0;

    align-items: center;

    gap: 7px;

    color: var(--color-primary-light);

    font-size: 0.68rem;
    font-weight: 850;

    white-space: nowrap;

    transition:
      color 250ms ease,
      gap 300ms ease;
  }

  .channel-button:hover .channel-action {
    gap: 10px;
    color: var(--color-cyan);
  }

  .channel-whatsapp .channel-action {
    color: var(--color-success);
  }

  .channel-whatsapp:hover .channel-action {
    color: #a3c8ae;
  }

  .action-arrow {
    display: grid;

    width: 25px;
    height: 25px;

    place-items: center;

    border: 1px solid currentColor;
    border-radius: 50%;

    opacity: 0.78;
  }

  .action-arrow svg {
    width: 12px;
    height: 12px;
  }

  .channel-corner {
    position: absolute;

    z-index: 3;

    width: 19px;
    height: 19px;

    pointer-events: none;
  }

  .corner-top {
    top: 7px;
    left: 7px;

    border-top: 1px solid
      rgba(95, 200, 216, 0.22);

    border-left: 1px solid
      rgba(95, 200, 216, 0.22);

    border-radius: 7px 0 0 0;
  }

  .corner-bottom {
    right: 7px;
    bottom: 7px;

    border-right: 1px solid
      rgba(176, 106, 200, 0.2);

    border-bottom: 1px solid
      rgba(176, 106, 200, 0.2);

    border-radius: 0 0 7px 0;
  }

  @media (max-width: 520px) {
    .channel-button {
      min-height: 0;

      padding: 15px;

      border-radius: var(--radius-md);
    }

    .channel-top {
      margin-bottom: 15px;
    }

    .channel-main {
      gap: 11px;
    }

    .channel-icon {
      flex-basis: 45px;

      width: 45px;
      height: 45px;

      border-radius: 12px;
    }

    .channel-icon svg {
      width: 22px;
      height: 22px;
    }

    .channel-name {
      font-size: 0.9rem;
    }

    .channel-context {
      font-size: 0.58rem;
    }

    .channel-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      margin-top: 15px;
      padding-top: 11px;
    }

    .channel-description {
      max-width: 100%;
      font-size: 0.61rem;
    }

    .channel-action {
      font-size: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-button,
    .channel-background,
    .channel-icon,
    .channel-action {
      transition: none;
    }
  }
</style>
